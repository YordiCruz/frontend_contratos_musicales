import { Component, Input, Output, EventEmitter, OnChanges } from '@angular/core';
import { FormGroup, FormControl, ReactiveFormsModule, Validators } from '@angular/forms';
import Swal from 'sweetalert2';
import { PrimengModule } from '../../../../primeng/primeng-module';
import { CategoriaService } from '../../../services/categoria-service';
@Component({
  selector: 'app-categoria',
  standalone: true,
  imports: [PrimengModule, ReactiveFormsModule],
  templateUrl: './form.html'
})
// export class CategoriaComponent implements OnChanges {
export class CategoriaComponent {
  
  @Input() visible: boolean = false;
  @Output() visibleChange = new EventEmitter<boolean>();
  @Input() categoriaSeleccionada: any = null;
  @Output() saved = new EventEmitter<void>();

  categoriaForm = new FormGroup({
    nombre: new FormControl('', [Validators.required]),
    descripcion: new FormControl('')
  });

  isEdit = false;

  constructor(private categoriaService: CategoriaService) {}

  // ngOnChanges() {
  //   if (this.categoriaSeleccionada) {
  //     this.isEdit = true;
  //     this.categoriaForm.patchValue({
  //       nombre: this.categoriaSeleccionada.nombre ?? '',
  //       descripcion: this.categoriaSeleccionada.descripcion ?? ''
  //     });
  //   } else {
  //     this.isEdit = false;
  //     this.categoriaForm.reset({ nombre: '', descripcion: '' });
  //   }
  // }

  guardarCategoria() {
    if (this.categoriaForm.invalid) return;

    // const payload: Partial<CategoriaIntegrante> = {
    const payload: any= {
      nombre: this.categoriaForm.value.nombre ?? undefined,
      descripcion: this.categoriaForm.value.descripcion ?? undefined
    };

    if (this.isEdit && this.categoriaSeleccionada?.id_categoria) {
      this.categoriaService.update(this.categoriaSeleccionada.id_categoria, payload).subscribe({
        next: () => {
          Swal.fire('¡Actualizado!', 'La categoría se actualizó correctamente', 'success');
          this.closeDialog();
          this.saved.emit();
        },
        error: (err) => Swal.fire('Error', err.error?.message || 'Error al actualizar', 'error')
      });
    } else {
      this.categoriaService.store(payload).subscribe({
        next: () => {
          Swal.fire('¡Creado!', 'La categoría se creó correctamente', 'success');
          this.closeDialog();
          this.saved.emit();
        },
        error: (err) => Swal.fire('Error', err.error?.message || 'Error al crear', 'error')
      });
    }
  }

  closeDialog() {
    this.visible = false;
    this.visibleChange.emit(false);
    this.isEdit = false;
    this.categoriaSeleccionada = null;
    this.categoriaForm.reset({ nombre: '', descripcion: '' });
  }
}
