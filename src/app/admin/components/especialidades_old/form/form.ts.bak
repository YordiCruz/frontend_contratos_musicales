import { Component, Input, Output, EventEmitter, OnChanges, ChangeDetectorRef } from '@angular/core';
import { FormGroup, FormControl, Validators, ReactiveFormsModule } from '@angular/forms';
import Swal from 'sweetalert2';
import { PrimengModule } from '../../../../primeng/primeng-module';
import { EspecialidadesService } from '../../../services/especialidades-service';
import { CategoriasIntegrantesService } from '../../../services/categoria-service';
import { Especialidad } from '../../../interfaces/especialidad';

@Component({
  selector: 'app-especialidad-form',
  standalone: true,
  imports: [PrimengModule, ReactiveFormsModule],
  templateUrl: './form.html'
})
export class EspecialidadFormComponent implements OnChanges {
  @Input() visible: boolean = false;
  @Output() visibleChange = new EventEmitter<boolean>();
  @Input() especialidadSeleccionada: Especialidad | null = null;
  @Output() saved = new EventEmitter<void>();

  especialidadForm = new FormGroup({
    nombre: new FormControl('', [Validators.required]),
    descripcion: new FormControl(''),
    nivel_dificultad: new FormControl(1, [Validators.required]),
    id_categoria: new FormControl('', [Validators.required])
  });

  isEdit = false;
  categorias: any[] = [];

  constructor(
    private especialidadesService: EspecialidadesService,
    private categoriasService: CategoriasIntegrantesService,
     private cd: ChangeDetectorRef
  ) {}



 
ngOnChanges() {
  this.isEdit = !!this.especialidadSeleccionada;

  this.loadCategorias(() => {
    if (this.especialidadSeleccionada) {
      this.especialidadForm.patchValue({
        nombre: this.especialidadSeleccionada.nombre,
        descripcion: this.especialidadSeleccionada.descripcion,
        nivel_dificultad: Number(this.especialidadSeleccionada.nivel_dificultad),
        id_categoria: this.especialidadSeleccionada.categoria?.id_categoria || this.especialidadSeleccionada.id_categoria
      });
    }
  });
}


// Método separado
loadCategorias(callback?: () => void) {
  this.categoriasService.getAll().subscribe({
    next: (res) => {
      this.categorias = res;
      this.cd.detectChanges();
      if (callback) callback(); // ahora sí podemos patchValue
    },
    error: (err) => console.error(err)
  });
}


  guardarEspecialidad() {
    if (this.especialidadForm.invalid) return;

 const payload: Partial<Especialidad> = {
  ...this.especialidadForm.value,
  nombre: this.especialidadForm.value.nombre ?? undefined,
  descripcion: this.especialidadForm.value.descripcion ?? undefined,
  nivel_dificultad: Number(this.especialidadForm.value.nivel_dificultad),
  id_categoria: this.especialidadForm.value.id_categoria ?? undefined,
};


    if (this.isEdit && this.especialidadSeleccionada?.id_especialidad) {
      this.especialidadesService.update(this.especialidadSeleccionada.id_especialidad, payload).subscribe({
        
        next: () => {
          Swal.fire('¡Actualizado!', 'La especialidad se actualizó correctamente', 'success');
          this.closeDialog();
          this.saved.emit();
        },
        error: (err) => Swal.fire('Error', err.error?.message || 'Error al actualizar', 'error')
      });
      console.log('Payload:', payload);

    } else {
      this.especialidadesService.create(payload).subscribe({
        next: () => {
          Swal.fire('¡Creado!', 'La especialidad se creó correctamente', 'success');
          this.closeDialog();
          this.saved.emit();
        },
        error: (err) => Swal.fire('Error', err.error?.message || 'Error al crear', 'error')
      });
    }
  }

  closeDialog() {
    this.visible = false;
    this.visibleChange.emit(false);
    this.isEdit = false;
    this.especialidadSeleccionada = null;
    this.especialidadForm.reset({ nombre: '', descripcion: '', nivel_dificultad: 1, id_categoria: '' });
  }
}

